# cp .env.example .env && chmod 600 .env
# 变量名与 VPS 版 keepalive.sh 完全一致，多账号写法也一样（逗号叠加）
INSTABOX_API_KEY=ibk_xxxxxxxxxxxxxxxxxxxxxxxx

# 留空或 all = 保活这把 key 名下全部机器；填名字则只保那台，多台用逗号分隔
INSTABOX_MACHINE=all

# 以下都有默认值，需要时再打开
# INSTABOX_LEASE=keepalive
# INSTABOX_LEASE_TTL=900
# INSTABOX_RENEW_EVERY=180
# INSTABOX_AUTO_RESUME=1
# INSTABOX_API_URL=https://api.instabox.sh

# ── 停机检修轮转（与 Worker 版同款逻辑，默认开）────────────────
# 到点（默认 01:30/08:00/13:00/19:00）或快到 max-run 上限时主动 suspend→resume，
# 把「连续运行」计时清零，绕开平台的强制挂起 + 10 分钟冷却
# INSTABOX_CYCLE=1              # 0 = 关（只续租、绝不主动重启）
# INSTABOX_CYCLE_AT=01:30,08:00,13:00,19:00
# INSTABOX_CYCLE_TZ=Asia/Shanghai
# INSTABOX_CYCLE_WINDOW_MIN=30  # 到点后多少分钟内动手
# INSTABOX_CYCLE_MARGIN_MIN=20  # 剩多少分钟到上限时兜底轮转（0 = 只按时间点）
# INSTABOX_CYCLE_JITTER_MIN=0-0 # 开始时间抖动（分钟区间）
# INSTABOX_CYCLE_HOLD_SEC=0-0   # suspend→resume 之间停多久（秒区间，封顶 600）
# INSTABOX_WAKE_JITTER_MIN=0-0  # 平台冷却后额外等待（分钟区间）
