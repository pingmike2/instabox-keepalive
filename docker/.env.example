# cp .env.example .env && chmod 600 .env
# 变量名与 VPS 版 keepalive.sh 完全一致，多账号写法也一样（逗号叠加）
INSTABOX_API_KEY=ibk_xxxxxxxxxxxxxxxxxxxxxxxx

# 留空或 all = 保活这把 key 名下全部机器；填名字则只保那台，多台用逗号分隔
INSTABOX_MACHINE=all

# 以下都有默认值，需要时再打开
# INSTABOX_LEASE=keepalive
# INSTABOX_LEASE_TTL=900
# INSTABOX_RENEW_EVERY=180
# INSTABOX_AUTO_RESUME=1
# INSTABOX_API_URL=https://api.instabox.sh
